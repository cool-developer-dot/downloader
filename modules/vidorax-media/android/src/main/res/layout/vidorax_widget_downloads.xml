<?xml version="1.0" encoding="utf-8"?>
<!-- H22 Home Widget (#456): up to three active downloads and "Paste link". RTL-safe: start/end only, text follows the locale. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/vidorax_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/vidorax_widget_background"
  android:layoutDirection="locale"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/vidorax_widget_header_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:contentDescription="@string/vidorax_widget_open_downloads"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/vidorax_widget_title"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text"
      android:textDirection="locale"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/vidorax_widget_paste_link"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/vidorax_widget_button"
      android:gravity="center"
      android:minHeight="36dp"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:text="@string/vidorax_widget_paste_link"
      android:textColor="@color/vidorax_widget_button_text"
      android:textSize="13sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/vidorax_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="@string/vidorax_widget_empty"
    android:textAlignment="viewStart"
    android:textColor="@color/vidorax_widget_text_secondary"
    android:textDirection="locale"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/vidorax_widget_row0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/vidorax_widget_row0_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text"
      android:textDirection="locale"
      android:textSize="13sp" />

    <ProgressBar
      android:id="@+id/vidorax_widget_row0_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginTop="3dp"
      android:max="100" />

    <TextView
      android:id="@+id/vidorax_widget_row0_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text_secondary"
      android:textDirection="locale"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/vidorax_widget_row1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/vidorax_widget_row1_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text"
      android:textDirection="locale"
      android:textSize="13sp" />

    <ProgressBar
      android:id="@+id/vidorax_widget_row1_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginTop="3dp"
      android:max="100" />

    <TextView
      android:id="@+id/vidorax_widget_row1_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text_secondary"
      android:textDirection="locale"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/vidorax_widget_row2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/vidorax_widget_row2_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text"
      android:textDirection="locale"
      android:textSize="13sp" />

    <ProgressBar
      android:id="@+id/vidorax_widget_row2_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginTop="3dp"
      android:max="100" />

    <TextView
      android:id="@+id/vidorax_widget_row2_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:maxLines="1"
      android:textAlignment="viewStart"
      android:textColor="@color/vidorax_widget_text_secondary"
      android:textDirection="locale"
      android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
