<resources>
  <!-- The launch screen follows the app's theme: white here (Light / Logo, colors.ts palette.neutralWhite), #0D0D0D in
       values-night (Dark). The app's choice reaches these resources before the first frame (AppNightMode: per-app night
       mode on Android 12+, AppCompat in MainApplication), and the in-app splash that follows paints the same colour, so
       the launch never flashes. splashscreen_logo is the transparent VidoraX logo with the "VidoraX" wordmark
       underneath (#171717 here, #F5F5F5 in drawable-night-*), rendered by scripts/dev/render-native-splash.py. -->
  <color name="splashscreen_background">#FFFFFF</color>
  <bool name="launch_light_system_bars">true</bool>
  <!-- The frame between the splash and the first React paint follows the app's own background, so the app
       never opens on a colour it is about to replace. -->
  <color name="window_background">#FFFFFF</color>
  <!-- Adaptive icon plate — current VidoraX brand (not Expo default blue). -->
  <color name="iconBackground">#FF9A3D</color>
  <color name="colorPrimary">#ACC8A2</color>
  <color name="notification_icon_color">#1A2517</color>
</resources>
