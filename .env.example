# VidoraX mobile environment
#
# Local-first production: do not configure a VidoraX backend URL.
# The app does not require Render, Postgres, JWT, or a VidoraX API.
#
# Feature flags (optional, opt-out)
# All features are enabled by default in development AND production.
# Set a flag to "false" (or "0") only to disable it for a specific build.
# EXPO_PUBLIC_ENABLE_BROWSER=false
# EXPO_PUBLIC_ENABLE_DOWNLOADER=false
# EXPO_PUBLIC_ENABLE_PLAYER=false
